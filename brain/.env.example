# ── Runtime ──────────────────────────────────────────────────────────────────
APP_ENV=prod
API_HOST=0.0.0.0
API_PORT=8080

# Path to the SQLite database file (relative to the brain/ working directory)
DATABASE_PATH=./brain.db

# ── Metaclaw webhook ─────────────────────────────────────────────────────────
# Secret used to verify HMAC-SHA256 signatures on incoming Metaclaw webhooks.
# Set this to the same value configured in your Metaclaw instance.
# If left empty, signature verification is SKIPPED (dev only — never in prod).
METACLAW_WEBHOOK_SECRET=change_me_metaclaw_secret

# ── Slack ─────────────────────────────────────────────────────────────────────
# From your Slack App → Basic Information → Signing Secret
SLACK_SIGNING_SECRET=change_me_slack_signing_secret

# Bot token (xoxb-...) from Slack App → OAuth & Permissions
# Scopes needed: chat:write, chat:write.public
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Channel where approval messages and notifications are posted (e.g. C0123456789)
SLACK_CHANNEL_ID=C0000000000

# Your personal Slack member ID — only this user can approve/reject signals.
# Find it in Slack: click your name → View full profile → copy Member ID (U...)
SLACK_ADMIN_USER_ID=U0000000000

# ── Risk policy ───────────────────────────────────────────────────────────────
# Hard cap: signals with notional >= this value are REJECTED outright.
MAX_NOTIONAL_USD=2000.0

# Signals at or above this threshold always require explicit Slack approval
# (even if AUTO_APPROVE_LOW_RISK is true).
REQUIRE_APPROVAL_THRESHOLD_USD=100.0

# Set to true ONLY if you want LOW-risk signals below the threshold to execute
# without Slack approval. Default: false (every signal requires your approval).
AUTO_APPROVE_LOW_RISK=false

# ── Brain API key ─────────────────────────────────────────────────────────────
# Bearer token for /killswitch, /signals, and /audit endpoints.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
BRAIN_API_KEY=change_me_brain_api_key
