# ── Runtime ──────────────────────────────────────────────────────────────────
APP_ENV=prod
API_HOST=0.0.0.0
API_PORT=8080
DATABASE_PATH=./brain.db

# ── Metaclaw webhook ─────────────────────────────────────────────────────────
# Any secret string — set the same value in your Metaclaw config.
# Leave empty to skip signature verification (dev only).
METACLAW_WEBHOOK_SECRET=change_me_metaclaw_secret

# ── Slack ─────────────────────────────────────────────────────────────────────
# Bot token (xoxb-) — api.slack.com → your app → OAuth & Permissions
# Used for SENDING messages. Scopes needed: chat:write
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# App-level token (xapp-) — api.slack.com → your app → Basic Information → App-Level Tokens
# Used for RECEIVING button clicks via Socket Mode (no public URL needed).
# Scope needed: connections:write
SLACK_APP_TOKEN=xapp-your-app-token-here

# Channel where approval messages and notifications are posted
SLACK_CHANNEL_ID=C0000000000

# Your personal Slack member ID — only this user can approve/reject signals.
# Find it: Slack → click your name → Profile → ··· → Copy member ID (U...)
SLACK_ADMIN_USER_ID=U0000000000

# ── Risk policy ───────────────────────────────────────────────────────────────
MAX_NOTIONAL_USD=2000.0
REQUIRE_APPROVAL_THRESHOLD_USD=100.0
AUTO_APPROVE_LOW_RISK=false

# ── Brain API key ─────────────────────────────────────────────────────────────
# Bearer token for /killswitch, /signals, /audit endpoints.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
BRAIN_API_KEY=change_me_brain_api_key
