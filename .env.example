# Anthropic Claude API (required)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Exchange credentials — only needed when DRY_RUN=false
# Leave blank to run in analysis-only / dry-run mode (no account needed)
EXCHANGE_ID=binance
EXCHANGE_API_KEY=
EXCHANGE_SECRET=

# Bot settings
TRADING_PAIR=BTC/USDT
TRADE_AMOUNT_USDT=100
DRY_RUN=true
CHECK_INTERVAL_MINUTES=15
