# Anthropic Claude API (primary AI engine)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Google Gemini API (fallback when Claude quota is exhausted)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# Exchange credentials — only needed when DRY_RUN=false
# Leave blank to run in analysis-only / dry-run mode (no account needed)
# Use "bitunix" for direct Bitunix integration (recommended)
# Other CCXT options: kraken, kucoin, bybit, okx (binance is geo-restricted in some regions)
EXCHANGE_ID=bitunix
EXCHANGE_API_KEY=
EXCHANGE_SECRET=

# Bot settings
TRADING_PAIR=BTC/USDT
TRADE_AMOUNT_USDT=100
DRY_RUN=true
CHECK_INTERVAL_MINUTES=15
